# Copia este archivo como .env y completa los valores. Nunca subas el .env al repositorio.
# Variables de la sección 10.4 del contrato. Las marcadas (obligatoria) impiden arrancar si faltan.

# Puerto HTTP del servicio. Por defecto 3000.
PORT=3000

# (obligatoria) Conexión a PostgreSQL. Debe coincidir con docker-compose.yml.
DATABASE_URL=postgres://facturacion:facturacion@localhost:5432/facturacion

# (obligatoria) Clave que el supervisor envía en X-API-Key.
SERVICE_API_KEY=cambia-esta-clave

# (obligatoria) Fireworks AI. Verifica la URL y el identificador del modelo en la documentación vigente.
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/gpt-oss-120b

# Tiempo máximo por llamada al modelo (ms) y tope de tokens de salida.
LLM_TIMEOUT_MS=15000
LLM_MAX_TOKENS=1000

# (obligatoria) Secreto del servidor para calcular el hash de las keys de los negocios (A2A).
# Mínimo 32 caracteres: openssl rand -hex 32. Si lo cambias, todas las keys dejan de servir.
PARTNER_KEY_PEPPER=

# URL pública del servicio (sin barra final); la anuncia la tarjeta del bot en /.well-known/agent.json.
# Por defecto: http://localhost:PORT. En producción debe ser https.
A2A_PUBLIC_BASE_URL=

# Proxies delante del servicio. En Render/Railway: 1 (para que el bloqueo por IP vea la IP real).
# En local déjalo vacío o en 0.
TRUST_PROXY=

# Tasa de impuesto como decimal: 0.19, o 0 para desactivarlo.
TAX_RATE=0.19

# Total máximo permitido por cuenta, sin separador de miles.
MAX_INVOICE_TOTAL=50000000

# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log
